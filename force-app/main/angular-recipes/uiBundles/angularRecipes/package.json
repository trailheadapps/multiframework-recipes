{
  "name": "angular-recipes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "sf-angular-serve",
    "dev:design": "sf-angular-serve --design",
    "build": "ng lint && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --coverage --coverage-reporters=lcovonly --coverage-reporters=text-summary --watch=false",
    "lint": "ng lint",
    "build:e2e": "ng lint && ng build && node scripts/rewrite-e2e-assets.mjs",
    "e2e": "playwright test",
    "graphql:schema": "node scripts/get-graphql-schema.mjs"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ng-icons/core": "^32.2.0",
    "@ng-icons/lucide": "^32.2.0",
    "@salesforce/angular-plugin-ui-bundle": "^11.62.1",
    "@salesforce/platform-sdk": "^11.62.1",
    "@salesforce/ui-bundle": "^11.62.1",
    "@spartan-ng/brain": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-builders/custom-esbuild": "^21.0.0",
    "@angular-eslint/builder": "^21.0.0",
    "@angular/build": "^21.2.11",
    "@angular/cli": "^21.2.11",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^9.0.0",
    "@graphql-eslint/eslint-plugin": "^4.1.0",
    "@graphql-tools/utils": "^11.2.2",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0",
    "angular-eslint": "^21.0.0",
    "eslint": "^9.0.0",
    "graphql": "^16.11.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.0",
    "serve": "^14.2.5",
    "shiki": "^4.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0"
  },
  "overrides": {
    "undici": "^7.28.0"
  }
}
