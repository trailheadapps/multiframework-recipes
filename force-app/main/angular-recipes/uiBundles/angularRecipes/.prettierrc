{
  "printWidth": 100,
  "singleQuote": true,
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "angular"
      }
    },
    {
      "files": "src/app/recipes/**/*.ts",
      "excludeFiles": "**/*.spec.ts",
      "options": {
        "printWidth": 90
      }
    }
  ]
}
